# Cadena de conexion a la misma base PostgreSQL que usa el
# pipeline de Airflow (tangara-airflow-pipeline).
#
# Local / mismo docker-compose (host = nombre del servicio postgres):
# DATABASE_URL=postgresql+psycopg2://ai_admin:ai_admin@postgres:5432/ai_project
#
# Local, corriendo el dashboard fuera de Docker (host = localhost):
DATABASE_URL=postgresql+psycopg2://ai_admin:ai_admin@localhost:5432/ai_project

# Puerto local (Render lo define solo con su propia variable PORT)
PORT=5000
