# =====================================
# CLICKHOUSE - Ecosistema Tangara
# https://github.com/sebaxtian/clickhouse-tangara
# =====================================
CLICKHOUSE_HOST=clickhouse.sebaxtian.dev
CLICKHOUSE_PORT=443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=tangara_plata
CLICKHOUSE_SECURE=True
CLICKHOUSE_TABLE=plata_tangara_sensores

# Filtro por sensores especificos, separados por coma.
# Cada codigo debe coincidir con el SUFIJO del nombre completo
# del sensor en ClickHouse (ej. 2FF6 -> D29ESP32DED2FF6).
# (dejar vacio para traer todos los sensores)
TANGARA_SENSOR_NAMES=2FF6,F1AE,1712,307A

# Ventana de extraccion incremental (horas hacia atras)
TANGARA_LOOKBACK_HOURS=24

# =====================================
# POSTGRESQL (Bronze / Silver / Gold)
# =====================================
POSTGRES_USER=ai_admin
POSTGRES_PASSWORD=ai_admin
POSTGRES_DB=ai_project
